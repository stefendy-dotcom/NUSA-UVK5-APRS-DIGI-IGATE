+#ifdef ENABLE_APRS
+static uint8_t SETTINGS_AprsCoordCheck(uint8_t delay, uint8_t tail, uint32_t lat, uint32_t lon)
+{
+    uint8_t c = (uint8_t)(0x5Au ^ delay ^ tail ^
+        (uint8_t)lat ^ (uint8_t)(lat >> 8) ^ (uint8_t)(lat >> 16) ^
+        (uint8_t)lon ^ (uint8_t)(lon >> 8) ^ (uint8_t)(lon >> 16));
+    c = (uint8_t)((c ^ (c >> 4)) & 0x7Fu);
+    return c ? c : 0x7Fu;
+}
+#endif
+
