+
+#ifdef ENABLE_APRS_STANDALONE
+#define APRS_META_ADDR 0x0E40u
+#define APRS_META_SIZE 40u
+
+static void SETTINGS_ResetAprsMetadataDefaults(void)
+{
+    memcpy(gAPRS_ObjectName, "NUSAIGATE", 10);
+    gAPRS_BeaconComment[0] = 0;
+    gAPRS_SymbolTable = '\\';
+    gAPRS_SymbolCode = '&';
+}
+
+static bool SETTINGS_LoadAprsMetadata(void)
+{
+    uint8_t meta[APRS_META_SIZE];
+    EEPROM_ReadBuffer(APRS_META_ADDR, meta, sizeof(meta));
+
+    SETTINGS_ResetAprsMetadataDefaults();
+
+    /* REV1H/REV1B old NAP2 firmware wrote only the first 8 bytes.
+     * Preserve the two fields that really existed, but never accept its
+     * truncated Object/Comment as valid persistent text. */
+    if (meta[0] == 'N' && meta[1] == 'A' && meta[2] == 'P' && meta[3] == '2') {
+        gAPRS_SymbolTable = (meta[4] == '\\') ? '\\' : '/';
+        if (meta[5] >= 33u && meta[5] <= 126u)
+            gAPRS_SymbolCode = (char)meta[5];
+        return false;
+    }
+
+    if (meta[0] != 'N' || meta[1] != 'A' || meta[2] != 'P' || meta[3] != '3')
+        return false;
+    const uint16_t stored_crc = (uint16_t)meta[31] | ((uint16_t)meta[32] << 8);
+    if (CRC_Calculate(meta, 31u) != stored_crc)
+        return false;
+
+    gAPRS_SymbolTable = (meta[4] == '\\') ? '\\' : '/';
+    if (meta[5] >= 33u && meta[5] <= 126u)
+        gAPRS_SymbolCode = (char)meta[5];
+
+    uint8_t n = 0;
+    for (uint8_t i = 0; i < 9u; i++) {
+        const uint8_t c = meta[6u + i];
+        if (c == 0u || c == 0xFFu)
+            break;
+        if (c >= 32u && c <= 126u)
+            gAPRS_ObjectName[n++] = (char)c;
+    }
+    while (n && gAPRS_ObjectName[n - 1u] == ' ')
+        n--;
+    gAPRS_ObjectName[n] = 0;
+    if (n == 0u)
+        memcpy(gAPRS_ObjectName, "NUSAIGATE", 10);
+
+    n = 0;
+    for (uint8_t i = 0; i < 16u; i++) {
+        const uint8_t c = meta[15u + i];
+        if (c == 0u || c == 0xFFu)
+            break;
+        if (c >= 32u && c <= 126u)
+            gAPRS_BeaconComment[n++] = (char)c;
+    }
+    while (n && gAPRS_BeaconComment[n - 1u] == ' ')
+        n--;
+    gAPRS_BeaconComment[n] = 0;
+    return true;
+}
+
+static void SETTINGS_SaveAprsMetadata(void)
+{
+    uint8_t meta[APRS_META_SIZE];
+    memset(meta, 0, sizeof(meta));
+    meta[0] = 'N'; meta[1] = 'A'; meta[2] = 'P'; meta[3] = '3';
+    meta[4] = (uint8_t)gAPRS_SymbolTable;
+    meta[5] = (uint8_t)gAPRS_SymbolCode;
+    for (uint8_t i = 0; i < 9u && gAPRS_ObjectName[i]; i++)
+        meta[6u + i] = (uint8_t)gAPRS_ObjectName[i];
+    for (uint8_t i = 0; i < 16u && gAPRS_BeaconComment[i]; i++)
+        meta[15u + i] = (uint8_t)gAPRS_BeaconComment[i];
+    const uint16_t crc = CRC_Calculate(meta, 31u);
+    meta[31] = (uint8_t)crc;
+    meta[32] = (uint8_t)(crc >> 8);
+
+    /* EEPROM_WriteBuffer() is intentionally an 8-byte page writer. */
+    for (uint8_t off = 0; off < APRS_META_SIZE; off += 8u)
+        EEPROM_WriteBuffer((uint16_t)(APRS_META_ADDR + off), &meta[off]);
+}
+#endif
