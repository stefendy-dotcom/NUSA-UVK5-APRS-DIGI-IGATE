--- a/settings.c
+++ b/settings.c
@@ -64,6 +64,18 @@
 
 EEPROM_Config_t gEeprom = { 0 };
 
+#ifdef ENABLE_APRS
+static uint8_t SETTINGS_AprsCoordCheck(uint8_t delay, uint8_t tail, uint32_t lat, uint32_t lon)
+{
+    uint8_t c = (uint8_t)(0x5Au ^ delay ^ tail ^
+        (uint8_t)lat ^ (uint8_t)(lat >> 8) ^ (uint8_t)(lat >> 16) ^
+        (uint8_t)lon ^ (uint8_t)(lon >> 8) ^ (uint8_t)(lon >> 16));
+    c = (uint8_t)((c ^ (c >> 4)) & 0x7Fu);
+    return c ? c : 0x7Fu;
+}
+#endif
+
+
 void SETTINGS_InitEEPROM(void)
 {
 	uint8_t Data[16] = {0};
@@ -275,15 +287,28 @@
 
 #ifdef ENABLE_APRS
 	/* 0F20..0F2F — NUSA APRS digi + timing + manual coordinates */
-	EEPROM_ReadBuffer(0x0F20, Data, 16);
+	EEPROM_ReadBuffer(0x0F20, Data, 8);
+	EEPROM_ReadBuffer(0x0F28, &Data[8], 8);
 	gAPRS_DigiCall[0] = 0;
 	gAPRS_TxDelay20ms = (Data[8] >= APRS_TX_DELAY_MIN_UNITS &&
 		Data[8] <= APRS_TX_DELAY_MAX_UNITS) ? Data[8] : APRS_TX_DELAY_DEFAULT_UNITS;
 	gAPRS_TxTail20ms = (Data[9] <= APRS_TX_TAIL_MAX_UNITS) ? Data[9] : APRS_TX_TAIL_DEFAULT_UNITS;
-	gAPRS_BeaconLat1e4 = (int32_t)((uint32_t)Data[10] | ((uint32_t)Data[11] << 8) | ((uint32_t)Data[12] << 16));
-	gAPRS_BeaconLon1e4 = (int32_t)((uint32_t)Data[13] | ((uint32_t)Data[14] << 8) | ((uint32_t)Data[15] << 16));
-	if (gAPRS_BeaconLat1e4 > 900000)  gAPRS_BeaconLat1e4 = 0;
-	if (gAPRS_BeaconLon1e4 > 1800000) gAPRS_BeaconLon1e4 = 0;
+	{
+		const uint32_t rawLat = (uint32_t)Data[10] | ((uint32_t)Data[11] << 8) | ((uint32_t)Data[12] << 16);
+		const uint32_t rawLon = (uint32_t)Data[13] | ((uint32_t)Data[14] << 8) | ((uint32_t)Data[15] << 16);
+		const uint8_t stored = (uint8_t)(((rawLat >> 20) & 0x0Fu) | (((rawLon >> 21) & 0x07u) << 4));
+		const uint32_t lat = rawLat & 0x0FFFFFu;
+		const uint32_t lon = rawLon & 0x1FFFFFu;
+		if (lat > 900000u || lon > 1800000u ||
+		    (stored != 0u && stored != SETTINGS_AprsCoordCheck(
+		        gAPRS_TxDelay20ms, gAPRS_TxTail20ms, lat, lon))) {
+			gAPRS_BeaconLat1e4 = 0;
+			gAPRS_BeaconLon1e4 = 0;
+		} else {
+			gAPRS_BeaconLat1e4 = (int32_t)lat;
+			gAPRS_BeaconLon1e4 = (int32_t)lon;
+		}
+	}
 	if (Data[0] == 0xFF) {
 		gAPRS_DigiFlags = APRS_DIGI_FLAG_WIDE2; /* mode OFF, WIDE2 only */
 		gAPRS_DigiSSID  = 0;
@@ -308,6 +333,7 @@
 				gAPRS_DigiFlags &= (uint8_t)~APRS_DIGI_MODE_MASK;
 		}
 	}
+
 #endif
 
 	// 0F40..0F47
@@ -677,12 +703,19 @@
 	memset(State, 0xFF, sizeof(State));
 	State[0] = gAPRS_TxDelay20ms;
 	State[1] = gAPRS_TxTail20ms;
-	State[2] = (uint8_t)(gAPRS_BeaconLat1e4);
-	State[3] = (uint8_t)(gAPRS_BeaconLat1e4 >> 8);
-	State[4] = (uint8_t)(gAPRS_BeaconLat1e4 >> 16);
-	State[5] = (uint8_t)(gAPRS_BeaconLon1e4);
-	State[6] = (uint8_t)(gAPRS_BeaconLon1e4 >> 8);
-	State[7] = (uint8_t)(gAPRS_BeaconLon1e4 >> 16);
+	{
+		uint32_t lat = (uint32_t)gAPRS_BeaconLat1e4 & 0x0FFFFFu;
+		uint32_t lon = (uint32_t)gAPRS_BeaconLon1e4 & 0x1FFFFFu;
+		const uint8_t check = SETTINGS_AprsCoordCheck(State[0], State[1], lat, lon);
+		lat |= (uint32_t)(check & 0x0Fu) << 20;
+		lon |= (uint32_t)(check >> 4) << 21;
+		State[2] = (uint8_t)lat;
+		State[3] = (uint8_t)(lat >> 8);
+		State[4] = (uint8_t)(lat >> 16);
+		State[5] = (uint8_t)lon;
+		State[6] = (uint8_t)(lon >> 8);
+		State[7] = (uint8_t)(lon >> 16);
+	}
 	EEPROM_WriteBuffer(0x0F28, State);
 #endif
 
