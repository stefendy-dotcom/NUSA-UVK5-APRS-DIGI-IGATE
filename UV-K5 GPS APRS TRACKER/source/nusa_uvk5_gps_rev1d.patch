+#include "bsp/dp32g030/dma.h"
+#include "driver/uart.h"
+static uint16_t gps_read_index;
+static uint8_t gps_baud_started;
+
+static void NUSA_GPS_Poll(void) {
+    const uint16_t end = (uint16_t)(DMA_CH0->ST & 0xFFFu) % sizeof(UART_DMA_Buffer);
+    extern volatile uint32_t gGlobalSysTickCounter;
+    if (!gps_baud_started) {
+        NUSA_GPS_AutoBaud_Reset(gGlobalSysTickCounter, nusa_gps.good_sentences);
+        gps_baud_started = 1u;
+    }
+    while (gps_read_index != end) {
+        NUSA_GPS_Feed(UART_DMA_Buffer[gps_read_index], gGlobalSysTickCounter);
+        gps_read_index = (uint16_t)((gps_read_index + 1u) % sizeof(UART_DMA_Buffer));
+    }
+    const int next = NUSA_GPS_AutoBaud_Update(gGlobalSysTickCounter,
+                                               nusa_gps.good_sentences);
+    if (next >= 0) {
+        NUSA_GPS_ResetStream();
+        UART_GPS_SetBaudIndex((uint8_t)next);
+        gps_read_index = 0u; // DMA destination counter reset by UART_Init
+    }
+}
+#endif
 #endif
