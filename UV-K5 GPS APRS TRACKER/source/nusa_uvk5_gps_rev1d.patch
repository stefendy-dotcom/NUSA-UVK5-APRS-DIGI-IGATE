+static uint8_t nusa_gps_baud_index;  // 0:9600, 1:38400, 2:115200
+void UART_GPS_SetBaudIndex(uint8_t index)
+{
+    if (index >= 3u || index == nusa_gps_baud_index) return;
+    nusa_gps_baud_index = index;
+    UART_Init();  // Reinitialize UART RX FIFO and DMA from offset zero.
+}
+uint32_t UART_GPS_GetBaud(void)
+{
+    static const uint32_t baud[3] = {9600u, 38400u, 115200u};
+    return baud[nusa_gps_baud_index];
+}
+#endif
+
 
