         Frequency = 48000000U - Frequency;
     }
 
+#ifdef ENABLE_NUSA_GPS
+    // DP32G030 calibrated UART divisor. The same correction is used by
+    // the original Quansheng 38400-baud UART driver.
+    static const uint32_t baud_divisor[3] = {9766u, 39053u, 117158u};
+    UART1->BAUD = Frequency / baud_divisor[nusa_gps_baud_index];
+#else
     UART1->BAUD = Frequency / 39053U;
+#endif
     UART1->CTRL = UART_CTRL_RXEN_BITS_ENABLE | UART_CTRL_TXEN_BITS_ENABLE | UART_CTRL_RXDMAEN_BITS_ENABLE;
